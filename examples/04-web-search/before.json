                {
                  "title": "Visitor guide",
                  "url": "https://travel.example/observatory",
                  "excerpt": "A guide to visiting the observatory."
                },
                {
                  "title": "Restoration archive",
                  "url": "https://northbridge-observatory.org/archive/restoration",
                  "excerpt": "The restoration restored the original telescope mount."
                },
                {
                  "title": "Restoration overview",
                  "url": "https://northbridge-observatory.org.example/overview",
                  "excerpt": "An independently published overview."
                }
              ]
            }
          }
        ]
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "type": "text",
        "text": "Retain the observatory’s own restoration evidence."
      }
    ]
