[
  {
    "role": "user",
    "parts": [
      {
        "type": "text",
        "text": "Investigate how Northbridge Observatory was restored."
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "type": "toolCall",
        "id": "earlier_search",
        "tool": "web_search",
        "args": {
          "query": "Northbridge Observatory opening hours"
        }
      }
    ]
  },
  {
    "role": "tool",
    "parts": [
      {
        "type": "toolResult",
        "callId": "earlier_search",
        "content": [
          {
            "type": "object",
            "data": {
              "results": [
                {
                  "title": "Hours",
                  "url": "https://northbridge-observatory.org/visit",
                  "excerpt": "Open on weekends."
                }
              ]
            }
          }
        ]
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "type": "toolCall",
        "id": "restoration_search",
        "tool": "web_search",
        "args": {
          "query": "Northbridge Observatory restoration"
        }
      }
    ]
  },
  {
    "role": "tool",
    "parts": [
      {
        "type": "toolResult",
        "callId": "restoration_search",
        "content": [
          {
            "type": "object",
            "data": {
              "results": [
                {
                  "title": "Restoring the dome",
